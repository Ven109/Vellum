# Vellum self-hosting configuration. Copy to .env and adjust; ./scripts/selfhost.sh does this for you
# and fills in random storage keys.

# --- Basics ------------------------------------------------------------------------------------------
# The address people use to reach Vellum. Used in invite, share and password-reset links, and for
# OAuth callbacks. Use https:// in production (sessions then get the Secure flag).
VELLUM_PUBLIC_URL=http://localhost:8787
# Port on the host machine.
VELLUM_PORT=8787
# Image tag to run (a release such as v1.2.0, or latest).
VELLUM_TAG=latest
# Log level: fatal, error, warn, info, debug.
LOG_LEVEL=info

# --- Object storage (images) -------------------------------------------------------------------------
# Credentials shared by Vellum and the bundled storage service. Use long random values.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
VELLUM_S3_BUCKET=vellum
# To use external S3-compatible storage (AWS S3, Cloudflare R2, Garage, SeaweedFS…) instead of the
# bundled service, set these in the vellum service and remove `storage` from docker-compose.yml:
# VELLUM_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# VELLUM_S3_REGION=eu-west-1

# --- Email (optional) --------------------------------------------------------------------------------
# Without SMTP, invite and password-reset emails are written to the server log instead.
# VELLUM_SMTP_URL=smtps://user:password@smtp.example.com
# VELLUM_MAIL_FROM=Vellum <vellum@example.com>

# --- Sign in with GitHub / Google (optional) ---------------------------------------------------------
# Callback URL: ${VELLUM_PUBLIC_URL}/api/auth/oauth/github/callback (or /google/callback).
# VELLUM_OAUTH_GITHUB_ID=
# VELLUM_OAUTH_GITHUB_SECRET=
# VELLUM_OAUTH_GOOGLE_ID=
# VELLUM_OAUTH_GOOGLE_SECRET=

# Voice sessions: require local-only speech (whisper.cpp and system voices), so no audio leaves writers'
# machines. Off by default.
# VELLUM_VOICE_LOCAL_ONLY=true
